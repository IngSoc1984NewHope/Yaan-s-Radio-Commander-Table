</AssemblerScript></CheatEntry><CheatEntry><ID>4</ID><Description>"READ-ONLY native JIT export (map-marker research)"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if not getOpenedProcessID() or getOpenedProcessID()==0 then error('Attach game first') end
local mono=LaunchMonoDataCollector()
if not mono or mono==0 then error('Mono unavailable') end
local groups={
  {'Radio','TokenUpdateController','UpdateToken'},
  {'Radio','TokenUpdateController','UpdateMe'},
  {'Radio','TokenUpdateController','LerpMe'},
  {'Lemrh','CheatEntity','SwitchCheat'},
  {'Lemrh','CheatController','CheatSwitched'},
  {'Radio','UnitController','AddSupplies'},
  {'Radio','StaminaUnitController','ConsumeStamina'},
  {'Radio','FuelUnitController','ConsumeFuel'},
  {'Radio','UnitController','DamageTaken'},
  {'Radio','UnitController','DamageTakenSimple'},
  {'Radio','UnitController','HealthyToDeadCore'}
}
local path=(os.getenv('TEMP') or '.')..'\\RadioCommander_NativeJIT_Report.txt'
local o=assert(io.open(path,'w'))
local function writeln(s) o:write(tostring(s),'\n') end
writeln('READ ONLY - JIT native code inspection. No save data is changed.')
for _,g in ipairs(groups) do
  local ns,cls,meth=g[1],g[2],g[3]
  writeln('\n=== '..ns..'.'..cls..':'..meth..' ===')
  local ok,res=pcall(function()
    local c=mono_findClass(ns,cls)
    if not c or c==0 then return 'Class missing' end
    local m=mono_class_findMethod(c,meth)
    if not m or m==0 then return 'Method missing' end
    local a=mono_compile_method(m)
    if not a or a==0 then return 'JIT compile failed' end
    local ji=mono_getJitInfo(a)
    local total=ji and ji.code_size or 128
    writeln(('JIT address: 0x%X; size: %s'):format(a,tostring(total)))
    total=math.min(math.max(total,16),320)
    local pos=a
    local finish=a+total
    while pos&lt;finish do
      local line=disassemble(pos)
      writeln(line)
      local step=getInstructionSize(pos)
      if not step or step&lt;1 or step&gt;32 then break end
      pos=pos+step
    end
    return 'OK'
  end)
  writeln(ok and res or ('ERROR: '..tostring(res)))
end
writeln('\n=== Radio.UnitAff/UnitTeam fields ===')
for _,cls in ipairs({'UnitAff','UnitTeam'}) do
  local c=mono_findClass('Radio',cls)
  if c and c~=0 then
    for _,f in ipairs(mono_class_enumFields(c) or {}) do
      writeln(cls..'.'..tostring(f.name)..' off='..tostring(f.offset)..' typename='..tostring(f.typename))
    end
  end
end
o:close()
print('Read-only JIT diagnostic: '..path)
showMessage('Read-only JIT diagnostic saved:\n'..path)
{$asm}
[DISABLE]
</AssemblerScript></CheatEntry></CheatEntries></CheatTable>