<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45"><CheatEntries><CheatEntry><ID>0</ID><Description>"Infinite ammo / friendly only [EXPERIMENTAL]"</Description><VariableType>Auto Assembler Script</VariableType><AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return "define(RC_AMMO_TARGET,0x10000000)" end
if not getOpenedProcessID() or getOpenedProcessID()==0 then error("Attach to Radio Commander first") end
local base=LaunchMonoDataCollector()
if not base or base==0 then error("Mono collector initialization failed") end
local function check(ns,cls,field,expected)
  local c=mono_findClass(ns,cls)
  if not c or c==0 then error("Missing class: "..ns.."."..cls) end
  local fs=mono_class_enumFields(c) or {}
  for _,f in ipairs(fs) do
    if f.name==field then
      if f.offset~=expected then error("Unsafe offset mismatch "..ns.."."..cls.."."..field) end
      return
    end
  end
  error("Missing field: "..ns.."."..cls.."."..field)
end
check("Radio","UnitController","unitStats",0x18)
check("Radio","SM_UniversalStatsSO","unitStats",0x18)
check("Radio","UnitStats","unitSide",0x1A8)
local defs={}
local c_RC_AMMO_TARGET=mono_findClass("Radio","UnitController")
if not c_RC_AMMO_TARGET or c_RC_AMMO_TARGET==0 then error("Missing Radio.UnitController") end
local m_RC_AMMO_TARGET=mono_class_findMethod(c_RC_AMMO_TARGET,"AddSupplies")
if not m_RC_AMMO_TARGET or m_RC_AMMO_TARGET==0 then error("Missing method UnitController.AddSupplies") end
local a_RC_AMMO_TARGET=mono_compile_method(m_RC_AMMO_TARGET)
if not a_RC_AMMO_TARGET or a_RC_AMMO_TARGET==0 then error("JIT failed: UnitController.AddSupplies") end
defs[#defs+1]=string.format("define(RC_AMMO_TARGET,0x%X)",a_RC_AMMO_TARGET)
return table.concat(defs,"\n")
{$asm}
alloc(RC_AMMO_CODE,2048,RC_AMMO_TARGET)
label(RC_AMMO_ALLOW)
label(RC_AMMO_ZERO)
RC_AMMO_CODE:
  push rax
  test rcx,rcx
  je RC_AMMO_ALLOW
  mov rax,[rcx+18]
  test rax,rax
  je RC_AMMO_ALLOW
  mov rax,[rax+18]
  test rax,rax
  je RC_AMMO_ALLOW
  cmp dword ptr [rax+1A8],0
  jne RC_AMMO_ALLOW
  // Only block NEGATIVE supply changes for player-friendly units.
  ucomiss xmm1,[RC_AMMO_ZERO]
  jae RC_AMMO_ALLOW
  pop rax
  ret
RC_AMMO_ALLOW:
  pop rax
  jmp RC_AMMO_ORIGINAL
RC_AMMO_ZERO:
  dd (float)0
HOOK(RC_AMMO_TARGET,RC_AMMO_CODE,RC_AMMO_ORIGINAL)
[DISABLE]
