    <CheatEntry>
      <ID>4</ID>
      <Description>"Live Squad Position Update"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return '' end
if not getOpenedProcessID() or getOpenedProcessID()==0 then error('Attach to Radio Commander first') end
local collector=LaunchMonoDataCollector()
if not collector or collector==0 then error('Mono collector not available') end
local function check(cl,field,expected)
  local class=mono_findClass('Radio',cl)
  if not class or class==0 then error('Missing Radio.'..cl) end
  local fs=mono_class_enumFields(class) or {}
  for _,f in ipairs(fs) do
    if f.name==field then
      if f.offset~=expected then
        error('Field offset mismatch Radio.'..cl..'.'..field)
      end
      return
    end
  end
  error('Missing field Radio.'..cl..'.'..field)
end
check('TokenUpdateController','autoupdateTokens',0x28)
check('TokenUpdateController','unitController',0x30)
check('UnitController','unitStats',0x18)
check('SM_UniversalStatsSO','unitStats',0x18)
check('UnitStats','unitSide',0x1A8)
local class=mono_findClass('Radio','TokenUpdateController')
if not class or class==0 then error('TokenUpdateController not found') end
local function jit(name)
  local method=mono_class_findMethod(class,name)
  if not method or method==0 then error('Method missing: '..name) end
  local addr=mono_compile_method(method)
  if not addr or addr==0 then error('JIT failed: '..name) end
  return addr
end
local update=jit('UpdateToken')
local tick=jit('UpdateMe')
local aa=[[
define(RC_MAP_UPDATE_SITE,0x__UPDATE__+2F)
define(RC_MAP_ME_SITE,0x__ME__+27)
// The 14-byte regions contain only the configuration read.
// Refuse unsupported game / Mono JIT builds.
assert(RC_MAP_UPDATE_SITE,48 8B 47 28 48 8B C8 83 39 00 0F B6 40 30)
assert(RC_MAP_ME_SITE,48 8B 46 28 48 8B C8 83 39 00 0F B6 40 30)
alloc(RC_MAP_MEM,4096,RC_MAP_UPDATE_SITE)
label(RC_MAP_UPDATE_CODE)
label(RC_MAP_UPDATE_DONE)
label(RC_MAP_UPDATE_ORIG)
label(RC_MAP_UPDATE_RET)
label(RC_MAP_ME_CODE)
label(RC_MAP_ME_DONE)
label(RC_MAP_ME_ORIG)
label(RC_MAP_ME_RET)
registersymbol(RC_MAP_UPDATE_SITE)
registersymbol(RC_MAP_ME_SITE)
registersymbol(RC_MAP_UPDATE_ORIG)
registersymbol(RC_MAP_ME_ORIG)
RC_MAP_MEM:
// UpdateToken(bool force): original ConfigEntity.GetBool reads
// are preserved for other factions; friendly receives eax=1 ONLY here.
RC_MAP_UPDATE_CODE:
  mov rax,[rdi+28]
  mov rcx,rax
  cmp dword ptr [rcx],00
  movzx eax,byte ptr [rax+30]
  push rdx
  mov rdx,[rdi+30]
  test rdx,rdx
  je RC_MAP_UPDATE_DONE
  mov rdx,[rdx+18]
  test rdx,rdx
  je RC_MAP_UPDATE_DONE
  mov rdx,[rdx+18]
  test rdx,rdx
  je RC_MAP_UPDATE_DONE
  cmp dword ptr [rdx+1A8],0
  jne RC_MAP_UPDATE_DONE
  mov eax,1
RC_MAP_UPDATE_DONE:
  pop rdx
  jmp RC_MAP_UPDATE_RET

// UpdateMe(): patch only the configuration-read result.
// rsi = this (TokenUpdateController) in this verified JIT build.
RC_MAP_ME_CODE:
  mov rax,[rsi+28]
  mov rcx,rax
  cmp dword ptr [rcx],00
  movzx eax,byte ptr [rax+30]
  push rdx
  mov rdx,[rsi+30]
  test rdx,rdx
  je RC_MAP_ME_DONE
  mov rdx,[rdx+18]
  test rdx,rdx
  je RC_MAP_ME_DONE
  mov rdx,[rdx+18]
  test rdx,rdx
  je RC_MAP_ME_DONE
  cmp dword ptr [rdx+1A8],0
  jne RC_MAP_ME_DONE
  mov eax,1
RC_MAP_ME_DONE:
  pop rdx
  jmp RC_MAP_ME_RET

// Original bytes saved for reversible patching.
RC_MAP_UPDATE_ORIG:
  readmem(RC_MAP_UPDATE_SITE,14)
RC_MAP_ME_ORIG:
  readmem(RC_MAP_ME_SITE,14)

// Fixed-size 14-byte absolute indirect jumps: no +/-2 GB assumption.
RC_MAP_UPDATE_SITE:
  db FF 25 00 00 00 00
  dq RC_MAP_UPDATE_CODE
RC_MAP_UPDATE_RET:
RC_MAP_ME_SITE:
  db FF 25 00 00 00 00
  dq RC_MAP_ME_CODE
RC_MAP_ME_RET:
]]
aa=aa:gsub('__UPDATE__',string.format('%X',update))
aa=aa:gsub('__ME__',string.format('%X',tick))
return aa
{$asm}
[DISABLE]
RC_MAP_UPDATE_SITE:
  readmem(RC_MAP_UPDATE_ORIG,14)
RC_MAP_ME_SITE:
  readmem(RC_MAP_ME_ORIG,14)
unregistersymbol(RC_MAP_UPDATE_SITE)
unregistersymbol(RC_MAP_ME_SITE)
unregistersymbol(RC_MAP_UPDATE_ORIG)
unregistersymbol(RC_MAP_ME_ORIG)
dealloc(RC_MAP_MEM)

</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols/>
</CheatTable>
