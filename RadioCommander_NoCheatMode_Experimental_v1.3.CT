    <CheatEntry>
      <ID>3</ID>
      <Description>"Friendly invulnerability [v0.3 test]"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return '' end
if not getOpenedProcessID() or getOpenedProcessID()==0 then error('Attach to Radio Commander first') end
local mono=LaunchMonoDataCollector()
if not mono or mono==0 then error('Mono not detected. Attach to the running Radio Commander game.') end
local function check(ns,cl,fname,offset)
  local c=mono_findClass(ns,cl)
  if not c or c==0 then error('Class missing: '..ns..'.'..cl) end
  local fields=mono_class_enumFields(c) or {}
  for _,f in ipairs(fields) do
    if f.name==fname then
      if f.offset~=offset then error('Offset mismatch: '..ns..'.'..cl..'.'..fname..' expected '..string.format('%X',offset)..' got '..tostring(f.offset)) end
      return
    end
  end
  error('Field missing: '..ns..'.'..cl..'.'..fname)
end
check("Radio","UnitController","unitStats",0x18)
check("Radio","SM_UniversalStatsSO","unitStats",0x18)
check("Radio","UnitStats","unitSide",0x1A8)

local cl_HIT=mono_findClass('Radio','UnitController')
if not cl_HIT or cl_HIT==0 then error('Missing class Radio.UnitController') end
local m_HIT=mono_class_findMethod(cl_HIT,'DamageTaken')
if not m_HIT or m_HIT==0 then error('Missing method UnitController.DamageTaken') end
local a_HIT=mono_compile_method(m_HIT)
if not a_HIT or a_HIT==0 then error('JIT compile failed for UnitController.DamageTaken') end
local cl_SIMPLE=mono_findClass('Radio','UnitController')
if not cl_SIMPLE or cl_SIMPLE==0 then error('Missing class Radio.UnitController') end
local m_SIMPLE=mono_class_findMethod(cl_SIMPLE,'DamageTakenSimple')
if not m_SIMPLE or m_SIMPLE==0 then error('Missing method UnitController.DamageTakenSimple') end
local a_SIMPLE=mono_compile_method(m_SIMPLE)
if not a_SIMPLE or a_SIMPLE==0 then error('JIT compile failed for UnitController.DamageTakenSimple') end
local cl_DEAD=mono_findClass('Radio','UnitController')
if not cl_DEAD or cl_DEAD==0 then error('Missing class Radio.UnitController') end
local m_DEAD=mono_class_findMethod(cl_DEAD,'HealthyToDeadCore')
if not m_DEAD or m_DEAD==0 then error('Missing method UnitController.HealthyToDeadCore') end
local a_DEAD=mono_compile_method(m_DEAD)
if not a_DEAD or a_DEAD==0 then error('JIT compile failed for UnitController.HealthyToDeadCore') end
local script=[[define(RC_HIT_ADDR,0x__ADDR_HIT__)
assert(RC_HIT_ADDR,55 48 8B EC 48 83 EC 50 48 89 75 F0 48 89 7D F8)
alloc(RC_HIT_MEM,4096,RC_HIT_ADDR)
label(RC_HIT_CODE)
label(RC_HIT_ORIG)
label(RC_HIT_RET)
label(RC_HIT_ALLOW)
registersymbol(RC_HIT_ADDR)
registersymbol(RC_HIT_ORIG)
RC_HIT_MEM:
RC_HIT_CODE:
  push rax
  test rcx,rcx
  je RC_HIT_ALLOW
  mov rax,[rcx+18]
  test rax,rax
  je RC_HIT_ALLOW
  mov rax,[rax+18]
  test rax,rax
  je RC_HIT_ALLOW
  cmp dword ptr [rax+1A8],0
  jne RC_HIT_ALLOW
  pop rax
  ret
RC_HIT_ALLOW:
  pop rax
  jmp RC_HIT_ORIG
RC_HIT_ORIG:
  readmem(RC_HIT_ADDR,16)
  // Fixed-size absolute jump back to the real original method.
  db FF 25 00 00 00 00
  dq RC_HIT_RET
RC_HIT_ADDR:
  // Fixed-size 14-byte indirect JMP, independent of +/-2GB range.
  db FF 25 00 00 00 00
  dq RC_HIT_CODE
  db 90 90
RC_HIT_RET:

define(RC_SIMPLE_ADDR,0x__ADDR_SIMPLE__)
assert(RC_SIMPLE_ADDR,55 48 8B EC 48 83 EC 50 48 89 7D E8 4C 89 75 F0)
alloc(RC_SIMPLE_MEM,4096,RC_SIMPLE_ADDR)
label(RC_SIMPLE_CODE)
label(RC_SIMPLE_ORIG)
label(RC_SIMPLE_RET)
label(RC_SIMPLE_ALLOW)
registersymbol(RC_SIMPLE_ADDR)
registersymbol(RC_SIMPLE_ORIG)
RC_SIMPLE_MEM:
RC_SIMPLE_CODE:
  push rax
  test rcx,rcx
  je RC_SIMPLE_ALLOW
  mov rax,[rcx+18]
  test rax,rax
  je RC_SIMPLE_ALLOW
  mov rax,[rax+18]
  test rax,rax
  je RC_SIMPLE_ALLOW
  cmp dword ptr [rax+1A8],0
  jne RC_SIMPLE_ALLOW
  pop rax
  xor eax,eax
  ret
RC_SIMPLE_ALLOW:
  pop rax
  jmp RC_SIMPLE_ORIG
RC_SIMPLE_ORIG:
  readmem(RC_SIMPLE_ADDR,16)
  // Fixed-size absolute jump back to the real original method.
  db FF 25 00 00 00 00
  dq RC_SIMPLE_RET
RC_SIMPLE_ADDR:
  // Fixed-size 14-byte indirect JMP, independent of +/-2GB range.
  db FF 25 00 00 00 00
  dq RC_SIMPLE_CODE
  db 90 90
RC_SIMPLE_RET:

define(RC_DEAD_ADDR,0x__ADDR_DEAD__)
assert(RC_DEAD_ADDR,55 48 8B EC 48 83 EC 30 48 89 7D F8 48 8B F9 48 89 55 F0)
alloc(RC_DEAD_MEM,4096,RC_DEAD_ADDR)
label(RC_DEAD_CODE)
label(RC_DEAD_ORIG)
label(RC_DEAD_RET)
label(RC_DEAD_ALLOW)
registersymbol(RC_DEAD_ADDR)
registersymbol(RC_DEAD_ORIG)
RC_DEAD_MEM:
RC_DEAD_CODE:
  push rax
  test rcx,rcx
  je RC_DEAD_ALLOW
  mov rax,[rcx+18]
  test rax,rax
  je RC_DEAD_ALLOW
  mov rax,[rax+18]
  test rax,rax
  je RC_DEAD_ALLOW
  cmp dword ptr [rax+1A8],0
  jne RC_DEAD_ALLOW
  pop rax
  ret
RC_DEAD_ALLOW:
  pop rax
  jmp RC_DEAD_ORIG
RC_DEAD_ORIG:
  readmem(RC_DEAD_ADDR,19)
  // Fixed-size absolute jump back to the real original method.
  db FF 25 00 00 00 00
  dq RC_DEAD_RET
RC_DEAD_ADDR:
  // Fixed-size 14-byte indirect JMP, independent of +/-2GB range.
  db FF 25 00 00 00 00
  dq RC_DEAD_CODE
  db 90 90 90 90 90
RC_DEAD_RET:
]]
script=script:gsub('__ADDR_HIT__', string.format('%X',a_HIT))
script=script:gsub('__ADDR_SIMPLE__', string.format('%X',a_SIMPLE))
script=script:gsub('__ADDR_DEAD__', string.format('%X',a_DEAD))
return script
{$asm}
[DISABLE]
RC_HIT_ADDR:
  readmem(RC_HIT_ORIG,16)
unregistersymbol(RC_HIT_ORIG)
unregistersymbol(RC_HIT_ADDR)
dealloc(RC_HIT_MEM)
RC_SIMPLE_ADDR:
  readmem(RC_SIMPLE_ORIG,16)
unregistersymbol(RC_SIMPLE_ORIG)
unregistersymbol(RC_SIMPLE_ADDR)
dealloc(RC_SIMPLE_MEM)
RC_DEAD_ADDR:
  readmem(RC_DEAD_ORIG,19)
unregistersymbol(RC_DEAD_ORIG)
unregistersymbol(RC_DEAD_ADDR)
dealloc(RC_DEAD_MEM)
</AssemblerScript>
