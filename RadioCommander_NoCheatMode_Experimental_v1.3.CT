<?xml version="1.0" encoding="utf-8"?>
<CheatTable UsesMono="1" CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Infinite ammunition - friendly [v0.3 test]"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return '' end
if not getOpenedProcessID() or getOpenedProcessID()==0 then error('Attach to Radio Commander first') end
local mono=LaunchMonoDataCollector()
if not mono or mono==0 then error('Mono not detected. Attach to the running Radio Commander game.') end
local function check(ns,cl,fname,offset)
  local c=mono_findClass(ns,cl)
  if not c or c==0 then error('Class missing: '..ns..'.'..cl) end
  local fields=mono_class_enumFields(c) or {}
  for _,f in ipairs(fields) do
    if f.name==fname then
      if f.offset~=offset then error('Offset mismatch: '..ns..'.'..cl..'.'..fname..' expected '..string.format('%X',offset)..' got '..tostring(f.offset)) end
      return
    end
  end
  error('Field missing: '..ns..'.'..cl..'.'..fname)
end
check("Radio","UnitController","unitStats",0x18)
check("Radio","SM_UniversalStatsSO","unitStats",0x18)
check("Radio","UnitStats","unitSide",0x1A8)
local class=mono_findClass('Radio','UnitController')
if not class or class==0 then error('Missing class Radio.UnitController') end
local method=mono_class_findMethod(class,'AddSupplies')
if not method or method==0 then error('Missing method Radio.UnitController.AddSupplies') end
local address=mono_compile_method(method)
if not address or address==0 then error('Could not compile method Radio.UnitController.AddSupplies') end
return ([[
define(RC_AMMO_ADDR,0x%X)
assert(RC_AMMO_ADDR,55 48 8B EC 48 83 EC 50 48 89 75 F0 48 89 7D F8)
alloc(RC_AMMO_MEM,4096,RC_AMMO_ADDR)
label(RC_AMMO_CODE)
label(RC_AMMO_ORIG)
label(RC_AMMO_RET)
label(RC_AMMO_ALLOW)
label(RC_AMMO_ZERO)
registersymbol(RC_AMMO_ADDR)
registersymbol(RC_AMMO_ORIG)
RC_AMMO_MEM:
RC_AMMO_CODE:
  push rax
  test rcx,rcx
  je RC_AMMO_ALLOW
  mov rax,[rcx+18]
  test rax,rax
  je RC_AMMO_ALLOW
  mov rax,[rax+18]
  test rax,rax
  je RC_AMMO_ALLOW
  cmp dword ptr [rax+1A8],0
  jne RC_AMMO_ALLOW
  // Keep positive refills and block ONLY negative supply changes.
  ucomiss xmm1,[RC_AMMO_ZERO]
  jp RC_AMMO_ALLOW
  jae RC_AMMO_ALLOW
  pop rax
  ret
RC_AMMO_ALLOW:
  pop rax
  jmp RC_AMMO_ORIG
RC_AMMO_ZERO:
  dd 00000000
RC_AMMO_ORIG:
  readmem(RC_AMMO_ADDR,16)
  // Fixed-size absolute jump back to the real original method.
  db FF 25 00 00 00 00
  dq RC_AMMO_RET
RC_AMMO_ADDR:
  // Fixed-size 14-byte indirect JMP, independent of +/-2GB range.
  db FF 25 00 00 00 00
  dq RC_AMMO_CODE
  db 90 90
RC_AMMO_RET:

]]):format(address)
{$asm}
[DISABLE]
RC_AMMO_ADDR:
  readmem(RC_AMMO_ORIG,16)
unregistersymbol(RC_AMMO_ORIG)
unregistersymbol(RC_AMMO_ADDR)
dealloc(RC_AMMO_MEM)
</AssemblerScript>
    </CheatEntry>
